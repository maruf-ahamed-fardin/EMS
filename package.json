{
  "name": "selorax-ems",
  "private": true,
  "version": "0.1.0",
  "description": "SeloraX Employee Management System",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --port 3000",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && jest --runInBand",
    "test:web": "vitest run",
    "test:api": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "e2e": "playwright test",
    "check:payload": "node scripts/check-payload.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "prisma db seed",
    "catalogue:sync": "tsx lib/services/catalogue/sync-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.102.8",
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.43.0",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "next": "16.3.4",
    "nodemailer": "10.0.2",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.87.0",
    "react-is": "^19.0.0",
    "recharts": "3.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "uqr": "0.1.3",
    "uuid": "11.1.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nestjs/testing": "11.2.3",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.2",
    "@types/nodemailer": "8.0.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-is": "^19",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jest": "30.5.1",
    "jsdom": "30.0.1",
    "pino-pretty": "13.1.3",
    "playwright-core": "1.63.0",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "5.0.0"
  },
  "resolutions": {
    "multer": "2.3.0",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
