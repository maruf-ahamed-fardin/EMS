# SeloraX Team Profile - Environment Variables

# ── 1. Supabase Cloud Database (Recommended for Production & Local) ───────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ── 2. Admin Security (Optional - Defaults provided if omitted) ───────────────
ADMIN_PASSWORD=selorax2026
SESSION_SECRET=selorax-super-secret-salt-2026

# ── 3. MySQL Database Configuration (Optional Alternative) ────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=selorax
MYSQL_SSL=false
