# Copy to .env.local for local development. Never commit real values.

# HR app's database. The site reads profiles from its kv_store table today.
# Host, user and database are required in production; there are no fallbacks.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=selorax
# verify = check the server certificate; off = local MySQL without TLS (refused in production)
MYSQL_TLS=off
# CA certificate (PEM file) for the HR server, when it isn't signed by a public CA
MYSQL_CA_FILE=

# The app's own database (tables are created by `npm run db:migrate`).
# Optional until the new backend features are switched on.
DATABASE_URL=
# verify = check the server certificate; off = local MySQL without TLS
DATABASE_TLS=off
# CA certificate (PEM file) for the DB server, when it isn't signed by a public CA
DATABASE_CA_FILE=

# Read-only connection to the HR database, used only by the kv_store sync
KV_DATABASE_URL=

# Public base URL, used for canonical links, the sitemap and link previews.
# Must be set for `next build` too, not just at runtime: statically rendered pages bake it in.
# Vercel deployments detect this automatically; set it when self-hosting.
SITE_URL=http://localhost:3000

# Browser origins allowed to send POST/PUT/PATCH/DELETE to the API, comma separated
ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=info
