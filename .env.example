# Copy to .env for local development. Values here match docker-compose.yml and are not secrets.
# Never put real credentials in this file or in .env on a shared machine (plan D8).

# ── Backend (validated by config/env.ts) ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://ems:ems-local-only@127.0.0.1:5433/ems
# Scratch database for `prisma migrate dev` and `yarn db:drift`
SHADOW_DATABASE_URL=postgresql://ems:ems-local-only@127.0.0.1:5433/ems_shadow
# Only for calling the API from another origin in development. Leave empty normally.
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
# The web app's URL: CSRF origin check, links in emails, Secure cookies when https
APP_URL=http://localhost:3000
# console prints emails in the API log. smtp with SMTP_URL sends them; Mailpit catches them locally:
#   MAIL_DRIVER=smtp  SMTP_URL=smtp://127.0.0.1:1025  (inbox at http://127.0.0.1:8025)
# Background jobs, such as closing attendance days
JOBS_ENABLED=true
MAIL_DRIVER=console
SMTP_URL=
MAIL_FROM=SeloraX People <no-reply@selorax.local>

# Documents (plan D4). local keeps files in STORAGE_LOCAL_DIR (relative to the repository root) and serves
# 60-second links itself: development only. Production needs s3: AWS S3, Cloudflare R2 or MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=ems-documents
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ── Demo data (yarn db:seed, development only) ───────────────────────────────────────────────
# Password for the four demo accounts (superadmin@, hr@, manager@, employee@demo.selorax.test).
# Pick your own; at least 10 characters and not a common password.
SEED_PASSWORD=

# ── Tests ────────────────────────────────────────────────────────────────────────────────────────
# Enables tests/integration/database.e2e-spec.ts. The database is wiped; its name must contain "test".
TEST_DATABASE_URL=postgresql://ems:ems-local-only@127.0.0.1:5433/ems_test

