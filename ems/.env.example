# Copy to .env for local development. Values here match docker-compose.yml and are not secrets.
# Never put real credentials in this file or in .env on a shared machine (plan D8).

# ── Backend (validated by backend/src/config/env.ts) ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://ems:ems-local-only@127.0.0.1:5433/ems
# Scratch database for `prisma migrate dev` and `npm run db:drift`
SHADOW_DATABASE_URL=postgresql://ems:ems-local-only@127.0.0.1:5433/ems_shadow
# Only for calling the API from another origin in development. Leave empty normally.
CORS_ORIGINS=
TRUST_PROXY_HOPS=1

# ── Tests ────────────────────────────────────────────────────────────────────────────────────────
# Enables backend/test/database.e2e-spec.ts. The database is wiped; its name must contain "test".
TEST_DATABASE_URL=postgresql://ems:ems-local-only@127.0.0.1:5433/ems_test

# ── Frontend ─────────────────────────────────────────────────────────────────────────────────────
# Where Next.js forwards /api/*. Required for production builds.
API_ORIGIN=http://127.0.0.1:4000
