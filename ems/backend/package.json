{
  "name": "@ems/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.2",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jest": "30.5.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "@ems/contracts": "0.1.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.0.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "4.6.1"
  }
}
