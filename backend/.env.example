# Copy to .env.local for local development. Never commit real values.

# Database owned by this backend (tables are created by `npm run db:migrate`)
DATABASE_URL=mysql://team_app:change-me@127.0.0.1:3306/selorax_team
# verify = check the server certificate; off = local MySQL without TLS
DATABASE_TLS=off
# CA certificate (PEM file) for the DB server, when it isn't signed by a public CA
DATABASE_CA_FILE=

# Read-only connection to the HR app's database (kv_store), used only by the sync
KV_DATABASE_URL=mysql://kv_reader:change-me@127.0.0.1:3306/selorax

# Browser origins allowed to send POST/PUT/PATCH/DELETE (the public frontend), comma separated
ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=info
