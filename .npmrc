# This project uses Yarn 4 (see .yarnrc.yml); the guards below are its npm equivalents, kept as a
# safety net in case anyone runs npm here anyway. Changing one means changing both.
#   min-release-age  <-> npmMinimalAgeGate
#   ignore-scripts   <-> enableScripts
#   save-exact       <-> defaultSemverRangePrefix
min-release-age=7
ignore-scripts=true
save-exact=true
engine-strict=true
