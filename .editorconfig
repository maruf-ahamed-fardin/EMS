# The formatting every editor should apply, so a diff never carries whitespace noise.
# ESLint and Prettier enforce the rest; this file only covers what editors decide.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown gives meaning to two trailing spaces
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
